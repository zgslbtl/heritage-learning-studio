# ---------------------------------------------------------------------------
# Heritage Learning Studio environment template
# Copy to .env and fill every value before deployment. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
# study = formal classes 1-4; beta = only Class 0, including in production.
DEPLOYMENT_MODE=study
# local = persistent host volume; blob/vercel are used for the Vercel beta stack.
STORAGE_BACKEND=local
# JD Cloud OSS (private bucket; uploads/downloads go through the authenticated API).
# STORAGE_BACKEND=jdcloud_oss
# OSS_ENDPOINT_URL=https://s3.cn-south-1.jdcloud-oss.com
# OSS_REGION=cn-south-1
# OSS_BUCKET=your-private-bucket
# OSS_ACCESS_KEY_ID=
# OSS_SECRET_ACCESS_KEY=
QUEUE_BACKEND=local
# Caddy hostname only: no https:// and no trailing slash.
SITE_ADDRESS=study.example.org
# Exact browser origin: https:// + hostname, no trailing slash.
PUBLIC_ORIGIN=https://study.example.org
COOKIE_SECURE=true
# Optional comma-separated extra origins; normally leave empty.
# EXTRA_ALLOWED_ORIGINS=

# Database (Compose constructs DATABASE_URL for the internal db service).
# Use an alphanumeric/hex password to avoid URL-encoding problems in DATABASE_URL.
POSTGRES_DB=heritage
POSTGRES_USER=heritage
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://heritage:replace-with-a-long-random-password@db:5432/heritage

# Secrets. ADMIN_PASSWORD must be at least 16 characters.
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# Never change after participants exist; it seeds allocation and code hashes.
ANON_CODE_PEPPER=replace-with-a-long-random-pepper-do-not-change-after-distribution
# email = the current PolyU-email gate (NOT verified SSO; see deployment handover).
AUTH_MODE=email

# Runtime
DATA_DIR=/data
AUTO_BOOTSTRAP=true
# Task durations (seconds): T1 24 min, T2 20 min.
T1_DURATION_SECONDS=1440
T2_DURATION_SECONDS=1200
# Legacy fallback used only by old records/rounds.
ROUND_DURATION_SECONDS=840
SESSION_TTL_HOURS=24
ADMIN_SESSION_HOURS=8
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_NULL_POOL=false
LOG_LEVEL=INFO

# DeepSeek text model (official OpenAI-compatible API).
# The app appends /chat/completions to this base URL.
TEXT_MODEL_BASE_URL=https://api.deepseek.com
TEXT_MODEL_NAME=deepseek-flash
TEXT_MODEL_API_KEY=
TEXT_MODEL_TIMEOUT_SECONDS=60
TEXT_TEMPERATURE=0.7
TEXT_MAX_OUTPUT_TOKENS=900
# "disabled" gives lower-latency direct replies suitable for the HLSF coach.
# Use "enabled" only if you intentionally want DeepSeek reasoning mode.
TEXT_MODEL_THINKING=disabled

# Keyframe image model. This is NOT an official DeepSeek image API; it is a separate
# provider. The current template targets Volcengine Ark / Doubao Seedream 5.0 pro.
# The app appends /images/generations to this base URL.
IMAGE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL_NAME=doubao-seedream-5-0-pro-260628
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_TIMEOUT_SECONDS=120
IMAGE_MODEL_SIZE=2K
IMAGE_MODEL_RESPONSE_FORMAT=url
IMAGE_MODEL_WATERMARK=false
IMAGE_MAX_CONCURRENCY=2
# 0 = no per-round cap; set a positive value to cap image cost.
IMAGE_JOB_LIMIT_PER_ROUND=0
IMAGE_PROMPT_OPTIMIZER_ENABLED=true
TEXT_MODEL_VISION_ENABLED=true
IMAGE_REFERENCE_ENABLED=true

# Study shape
CLASS_COUNT=4
PARTICIPANTS_PER_CLASS=30

# Vercel beta overrides (set in the dedicated project's server environment).
# DEPLOYMENT_MODE=beta
# STORAGE_BACKEND=blob
# QUEUE_BACKEND=vercel
# AUTO_BOOTSTRAP=false
# IMAGE_WORKER_ENABLED=false
# DATA_DIR=/tmp/heritage-learning
# DB_NULL_POOL=true
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=0
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# PUBLIC_ORIGIN=https://YOUR-PROJECT.vercel.app
# COOKIE_SECURE=true
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_REGION is provided by the platform; root vercel.json deploys to sin1.
